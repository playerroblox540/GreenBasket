# Required: set a long random secret (at least 32 characters)
SESSION_SECRET=replace-with-a-long-random-secret
PORT=3000
BASE_URL=http://localhost:3000

# Owner account is created on first start if it does not already exist.
OWNER_EMAIL=you@example.com
OWNER_PASSWORD=replace-with-a-strong-password
OWNER_DISPLAY_NAME=GreenBasket Owner

# Roblox OAuth app credentials from Creator Dashboard
ROBLOX_CLIENT_ID=
ROBLOX_CLIENT_SECRET=
ROBLOX_REDIRECT_URI=http://localhost:3000/auth/roblox/callback
ROBLOX_GROUP_ID=616609542

# Discord Developer Portal OAuth2 credentials
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback
